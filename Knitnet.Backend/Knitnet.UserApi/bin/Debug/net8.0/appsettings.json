{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_SUPABASE_DB_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_MIN_32_CHARS_LONG_SECRET_KEY!!",
    "Issuer": "KnitnetBackend",
    "Audience": "KnitnetFrontend",
    "ExpiryHours": 3
  },
  "SupabaseSettings": {
    "Url": "https://YOUR_PROJECT_REF.supabase.co",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY",
    "ProfileImagesBucket": "profile-images",
    "CompanyLogosBucket": "company-logos",
    "VerificationDocsBucket": "verification-docs"
  },
  "VerificationSettings": {
    "SnapshotCount": 15,
    "TempStoragePath": "/tmp/verification"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
